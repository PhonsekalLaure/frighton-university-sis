# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Supabase Server Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Required for npm run seed: use the ref from sislms331-sudo's Project URL.
SISLMS_SUPABASE_PROJECT_REF=your-sislms-project-ref

# LMS -> SIS inbound secret (must differ from LMS_SERVICE_API_KEY)
LMS_INTEGRATION_API_KEY=
# SIS -> LMS private service settings
LMS_API_URL=http://localhost:5001
LMS_SERVICE_API_KEY=
# Enable only after both migrations, worker, and joint tests pass.
LIBRARY_SELF_SERVICE_ENABLED=false
