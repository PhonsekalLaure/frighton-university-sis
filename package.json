{
  "name": "frighton-university-sis",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"client,server\" -c \"cyan,magenta\" \"npm run dev -w client\" \"npm run dev -w server\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client && npm run build -w server",
    "build:client": "npm run build -w client",
    "build:server": "npm run build -w server",
    "test:server": "npm run test -w server",
    "seed:students": "npm run seed:students -w server",
    "seed": "npm run seed -w server",
    "setup:sis": "npm run setup:sis -w server --",
    "reset:sis": "npm run reset:sis -w server --",
    "reset:students": "npm run reset:sis -w server --"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
